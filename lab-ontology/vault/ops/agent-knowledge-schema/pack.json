  "filing_rules": [
    {
      "kind": "project",
      "directory": "projects/",
      "examples": [
        "projects/example-research-project"
      ],
      "description": "Living current project truth: objectives, constraints, confirmed state, pending items, and decisions still affecting future work. May be incrementally updated by any Agent through the approval gateway; excludes task logs."
    },
    {
      "kind": "decision",
      "directory": "decisions/",
      "examples": [
        "decisions/example-choice"
      ],
      "description": "Rare, durable commitments that constrain future actions. Requires rationale, rejected alternatives, scope, implementation location, lifecycle state, and explicit revisit triggers. Excludes approvals and micro-decisions."
    },
    {
      "kind": "methodology",
      "directory": "methods/",
      "examples": [
        "methods/example-review-workflow"
      ],
      "description": "Reusable procedure an agent can execute, including inputs, steps, output contract, boundaries, failure conditions, maturity, and evidence limits."
    },
    {
      "kind": "synthesis",
      "directory": "syntheses/",
      "examples": [
        "syntheses/example-evidence-synthesis"
      ],
      "description": "Cross-independent-source conclusion that narrows choices. Must distinguish evidence, inference, confidence, contradictions, invalid uses, and module-to-global promotion conditions."
    },
    {
      "kind": "concept",
      "directory": "concepts/",
      "examples": [
        "concepts/example-feedback-loop"
      ],
      "description": "Stable mechanism repeatedly used in judgment and not better represented as a method, synthesis, decision, or project."
    },
    {
      "kind": "source",
      "directory": "sources/",
      "examples": [
        "sources/example-interview-notes"
      ],
      "description": "Curated evidence and candidate-claim pages with neutral semantic titles, provenance, source-family independence, maturity, allowed uses, evidence gaps, and optional derived results. On-demand retrieval only."
    }
  ],
  "gateway_min_version": "1.8.0",
  "inverse_only_link_types": [
    "uses",
    "superseded_by",
    "required_by"
  ],
